<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only manifest overlay. Adds the <profileable> tag so adb-attached
    profilers (Macrobenchmark, simpleperf, perfetto) can attach to the IME
    process. Intentionally NOT present in release/beta builds: shell-attached
    profiling on a production privacy keyboard is an unnecessary attack surface
    (heap dumps would expose freshly-typed text), and it is not required for
    normal end-user functionality.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <profileable android:shell="true"/>

        <!--
            ROADMAP §7 Next-12.2a — Roborazzi screenshot-test host.
            Declared in the debug overlay only so it never reaches release
            builds. `exported=false` keeps it unreachable to external
            apps even on debug devices.
        -->
        <activity
            android:name="dev.patrickgold.florisboard.screenshot.RoborazziHostActivity"
            android:exported="false"/>
    </application>
</manifest>
