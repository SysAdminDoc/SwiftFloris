<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) data extraction rules.

    Two separate <cloud-backup> and <device-transfer> rule sets are required
    by the new schema; the pre-31 single <full-backup-content> rule set is
    still referenced by `android:fullBackupContent="@xml/backup_rules"` for
    devices older than API 31.

    Privacy posture (load-bearing):

    1. Personal-dictionary SQLCipher DB (floris_user_dictionary*) is excluded
       from BOTH cloud backup and device transfer. It contains words the
       personal-learning pipeline promoted from real typing — names,
       addresses, codenames, slang. Cloud backup is excluded on principle.
       Device transfer is excluded because the SQLCipher passphrase is wrapped
       by an Android-Keystore-held AES-GCM key that is NOT exportable: the
       ciphertext would arrive at the new device with no key to decrypt it,
       bricking the dictionary AND leaking the encrypted PII blob.

    2. The Tink-wrapped passphrase preference file
       (floris_user_dictionary_key.xml) is excluded for the same reason — the
       wrap key is bound to the original device's keystore alias. Note: the
       Room DB file is named `floris_user_dictionary` (no `.db` suffix), so
       its WAL/journal siblings are `-wal`/`-shm`/`-journal` on the bare
       name. Quarantined `.plaintext-<timestamp>` recovery artifacts cannot
       be listed here (no wildcard support); they stay protected because the
       database domain is never included.

    3. JetPref non-encrypted preferences and the `files/ime/` extension/theme
       directory are safe to include (no typed-text history).
-->
<data-extraction-rules
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="FullBackupContent">
    <cloud-backup>
        <include
            domain="root"
            path="jetpref_datastore"/>
        <include
            domain="file"
            path="ime"/>
        <include
            domain="file"
            path="sticker_packs"/>
        <include
            domain="file"
            path="snippets"/>
        <include
            domain="file"
            path="hardware_keyboard_layouts.json"/>
        <include
            domain="file"
            path="custom_emoji_tags.json"/>
        <include
            domain="file"
            path="emoji_pin_groups.json"/>
        <!-- Hard excludes — never let these leave the device via cloud. -->
        <exclude
            domain="database"
            path="floris_user_dictionary"/>
        <exclude
            domain="database"
            path="floris_user_dictionary-journal"/>
        <exclude
            domain="database"
            path="floris_user_dictionary-wal"/>
        <exclude
            domain="database"
            path="floris_user_dictionary-shm"/>
        <exclude
            domain="sharedpref"
            path="floris_user_dictionary_key.xml"/>
        <exclude
            domain="sharedpref"
            path="swiftfloris_tasker_auth.xml"/>
        <!-- Clipboard history is a SQLCipher database whose passphrase is wrapped by a
             non-exportable Android Keystore key. Both the ciphertext and the wrapped
             passphrase stay on the device that minted the key. -->
        <exclude
            domain="database"
            path="clipboard_history"/>
        <exclude
            domain="database"
            path="clipboard_history-journal"/>
        <exclude
            domain="database"
            path="clipboard_history-wal"/>
        <exclude
            domain="database"
            path="clipboard_history-shm"/>
        <exclude
            domain="database"
            path="clipboard_files"/>
        <exclude
            domain="sharedpref"
            path="clipboard_history_key.xml"/>
        <exclude
            domain="sharedpref"
            path="clipboard_media_key.xml"/>
        <exclude
            domain="file"
            path="clipboard_history"/>
        <!-- Learned typing patterns — plaintext n-gram stores and trace logs. -->
        <exclude
            domain="file"
            path="personal_bigrams"/>
        <exclude
            domain="file"
            path="personal_trigrams"/>
        <exclude
            domain="file"
            path="correction_outcome_priors"/>
        <exclude
            domain="file"
            path="swiftkey_typing_traces.jsonl"/>
        <exclude
            domain="file"
            path="swiftkey_trace.enabled"/>
        <!-- Sync identity (X25519 private key) + local CRDT state. Devices
             pair via QR; identities must never clone through a backup. -->
        <exclude
            domain="file"
            path="sync"/>
        <!-- Runtime diagnostic logs — PII-safe but transient; no value in backup. -->
        <exclude
            domain="file"
            path="diagnostics"/>
    </cloud-backup>
    <device-transfer>
        <include
            domain="root"
            path="jetpref_datastore"/>
        <include
            domain="file"
            path="ime"/>
        <include
            domain="file"
            path="sticker_packs"/>
        <include
            domain="file"
            path="snippets"/>
        <include
            domain="file"
            path="hardware_keyboard_layouts.json"/>
        <include
            domain="file"
            path="custom_emoji_tags.json"/>
        <include
            domain="file"
            path="emoji_pin_groups.json"/>
        <!-- Even D2D transfer cannot carry these: the wrap key is bound to
             the original device's Android Keystore and the ciphertext is
             undecryptable on the new device. Forcing the user to re-enrol
             gives a defined, recoverable state. -->
        <exclude
            domain="database"
            path="floris_user_dictionary"/>
        <exclude
            domain="database"
            path="floris_user_dictionary-journal"/>
        <exclude
            domain="database"
            path="floris_user_dictionary-wal"/>
        <exclude
            domain="database"
            path="floris_user_dictionary-shm"/>
        <exclude
            domain="sharedpref"
            path="floris_user_dictionary_key.xml"/>
        <exclude
            domain="sharedpref"
            path="swiftfloris_tasker_auth.xml"/>
        <!-- Clipboard history is a SQLCipher database whose passphrase is wrapped by a
             non-exportable Android Keystore key. Both the ciphertext and the wrapped
             passphrase stay on the device that minted the key. -->
        <exclude
            domain="database"
            path="clipboard_history"/>
        <exclude
            domain="database"
            path="clipboard_history-journal"/>
        <exclude
            domain="database"
            path="clipboard_history-wal"/>
        <exclude
            domain="database"
            path="clipboard_history-shm"/>
        <exclude
            domain="database"
            path="clipboard_files"/>
        <exclude
            domain="sharedpref"
            path="clipboard_history_key.xml"/>
        <exclude
            domain="sharedpref"
            path="clipboard_media_key.xml"/>
        <exclude
            domain="file"
            path="clipboard_history"/>
        <exclude
            domain="file"
            path="personal_bigrams"/>
        <exclude
            domain="file"
            path="personal_trigrams"/>
        <exclude
            domain="file"
            path="correction_outcome_priors"/>
        <exclude
            domain="file"
            path="swiftkey_typing_traces.jsonl"/>
        <exclude
            domain="file"
            path="swiftkey_trace.enabled"/>
        <!-- Sync identity (X25519 private key) + local CRDT state. Devices
             pair via QR; identities must never clone through a backup. -->
        <exclude
            domain="file"
            path="sync"/>
        <exclude
            domain="file"
            path="diagnostics"/>
    </device-transfer>
</data-extraction-rules>
