<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8 and 8.1 (API 26-27).

    These releases cannot prove that the selected cloud transport uses client-side encryption.
    Excluding every eligible domain makes both cloud backup and device transfer export nothing.
    API 28 adds the encrypted portable allowlist in res/xml-v28/backup_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
    <exclude domain="device_root" path="."/>
    <exclude domain="device_file" path="."/>
    <exclude domain="device_database" path="."/>
    <exclude domain="device_sharedpref" path="."/>
</full-backup-content>
