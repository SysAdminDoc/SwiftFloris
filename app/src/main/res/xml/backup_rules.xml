<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for API 23-30 (pre-data-extraction-rules era).

    Privacy posture: this is the "no cloud, no telemetry" keyboard. The
    user dictionary table (floris_user_dictionary) records every word the
    personal-learning pipeline has promoted from the user's typing, which
    may include names, addresses, codenames, slang, and other PII. Auto
    Backup on these old API levels uploads to the user's Google Drive
    without granular cloud-vs-device-transfer control. This pre-31 file is
    therefore an allowlist: only JetPref state and files/ime are included.
    Learned typing files such as personal n-grams, correction priors, and
    SwiftKey trace logs remain outside those included paths. Android 12+
    cloud and device-transfer rules keep explicit excludes in
    data_extraction_rules.xml, where the schema accepts them.
-->
<full-backup-content>
    <include
        domain="root"
        path="jetpref_datastore"/>
    <include
        domain="file"
        path="ime"/>
</full-backup-content>
