    <!-- Bottom-right petal -->
    <ellipse cx="16" cy="22" rx="18" ry="26" fill="url(#flowerGrad)" opacity="0.85" transform="rotate(144 16 22)"/>
    
    <!-- Bottom-left petal -->
    <ellipse cx="-16" cy="22" rx="18" ry="26" fill="url(#flowerGrad)" opacity="0.9" transform="rotate(216 -16 22)"/>
    
    <!-- Top-left petal -->
    <ellipse cx="-26" cy="-8" rx="18" ry="26" fill="url(#flowerGrad)" opacity="0.85" transform="rotate(288 -26 -8)"/>
    
    <!-- Center circle -->
    <circle cx="0" cy="0" r="11" fill="#FFFFFF"/>
    
