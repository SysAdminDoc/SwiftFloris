<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for API 31+ (Android 12+).

    Privacy posture: this is the "no cloud, no telemetry" keyboard. The
    user dictionary (floris_user_dictionary) records every word the
    personal-learning pipeline has promoted from the user's typing and is
    therefore deliberately omitted from cloud-backup. It is also omitted
    from device-transfer because the SQLCipher database key is protected
    by Android Keystore material that cannot be treated as portable backup
    state. A restored encrypted DB without its key is worse than no DB.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="root"
            path="jetpref_datastore"/>
        <include
            domain="file"
            path="ime"/>
    </cloud-backup>
    <device-transfer>
        <include
            domain="root"
            path="jetpref_datastore"/>
        <include
            domain="file"
            path="ime"/>
    </device-transfer>
</data-extraction-rules>
