<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission needed to vibrate if the user has key press vibration enabled -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Permission needed to create notifications on devices running Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- WorkManager declares this optional tracker permission. Scheduled
         backups deliberately have no network constraint and SwiftFloris ships
         without network permissions. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove"/>

    <!-- Permission requested only from the Calendar quick-insert action. Lets
         users insert local agenda event titles + date/time from the smartbar. -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>

    <!-- ROADMAP §7 Next-10.1 — signature-protected permission addons must hold
         to fire REGISTER_ADDON broadcasts. Only packages co-signed with the
         same key as the IME (or whitelisted by the user via Settings → Addons)
         can request a self-registration callback. Addons are also subject to
         the no-INTERNET invariant verified by AddonEnumerator at enrolment. -->
    <permission
        android:name="io.github.sysadmindoc.swiftfloris.permission.REGISTER_ADDON"
        android:label="@string/app_name"
        android:protectionLevel="signature"/>

    <!-- ROADMAP §10.5 L7 — signature-protected permission MCP daemons should
         require on their bind service (McpBridgeContract.PERMISSION_BIND_MCP).
         Declared + held here so bindService succeeds against a daemon that
         correctly gates its service with it; protectionLevel="signature"
         keeps random apps from binding daemons. -->
    <permission
        android:name="io.github.sysadmindoc.swiftfloris.permission.BIND_MCP"
        android:label="@string/app_name"
        android:protectionLevel="signature"/>
    <uses-permission android:name="io.github.sysadmindoc.swiftfloris.permission.BIND_MCP"/>

    <!-- Android 11+ only: Define that FlorisBoard requests to see all apps that
          ship with an IME or Spell Check service. This is used to guide the user
          in the Settings Ui why FlorisBoard may not be working.
     -->
    <queries>
        <package android:name="org.futo.voiceinput"/>
        <intent>
            <action android:name="android.view.InputMethod"/>
        </intent>
        <intent>
            <action android:name="android.service.textservice.SpellCheckerService"/>
        </intent>
        <intent>
            <action android:name="com.google.zxing.client.android.SCAN"/>
        </intent>
        <!-- ROADMAP §7 Next-10.1 — addon package visibility. Lets the IME's
             AddonEnumerator (Next-10.2) see installed addon packages on
             Android 11+, where queries are required by default. -->
        <intent>
            <action android:name="io.github.sysadmindoc.swiftfloris.action.REGISTER_ADDON"/>
        </intent>
        <intent>
            <action android:name="io.github.sysadmindoc.swiftfloris.action.REGISTER_LANGUAGE_PACK"/>
        </intent>
        <intent>
            <action android:name="io.github.sysadmindoc.swiftfloris.action.REGISTER_THEME_PACK"/>
        </intent>
        <intent>
            <action android:name="io.github.sysadmindoc.swiftfloris.action.REGISTER_DICTIONARY_PACK"/>
        </intent>
        <intent>
            <action android:name="io.github.sysadmindoc.swiftfloris.action.REGISTER_LAYOUT_PACK"/>
        </intent>
        <intent>
            <action android:name="io.github.sysadmindoc.swiftfloris.action.REGISTER_POPUP_MAPPING_PACK"/>
        </intent>
        <intent>
            <action android:name="io.github.sysadmindoc.swiftfloris.action.REGISTER_SMART_COMPOSE_RUNTIME"/>
        </intent>
        <intent>
            <action android:name="io.github.sysadmindoc.swiftfloris.action.REGISTER_TRANSLATION_RUNTIME"/>
        </intent>
        <intent>
            <action android:name="io.github.sysadmindoc.swiftfloris.action.REGISTER_CJK_RUNTIME"/>
        </intent>
        <intent>
            <action android:name="io.github.sysadmindoc.swiftfloris.action.REGISTER_HANDWRITING_RUNTIME"/>
        </intent>
        <intent>
            <action android:name="io.github.sysadmindoc.swiftfloris.action.REGISTER_VOICE_RUNTIME"/>
        </intent>
        <!-- ROADMAP §10.5 L7.5 — MCP daemon visibility. Without this entry,
             McpAndroidDiscoverer's queryIntentServices() silently returns no
             candidates on Android 11+ package-visibility filtering. -->
        <intent>
            <action android:name="io.github.sysadmindoc.swiftfloris.action.BIND_MCP_DAEMON"/>
        </intent>
    </queries>

    <application
        android:name="dev.patrickgold.florisboard.FlorisApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/FlorisAppTheme"
        tools:targetApi="tiramisu">

        <!-- IME service -->
        <service
            android:name="dev.patrickgold.florisboard.FlorisImeService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod"/>
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method"/>
        </service>

        <!-- Spellchecker service -->
        <service
            android:name="dev.patrickgold.florisboard.FlorisSpellCheckerService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_TEXT_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.textservice.SpellCheckerService"/>
            </intent-filter>
            <meta-data android:name="android.view.textservice.scs" android:resource="@xml/spellchecker"/>
        </service>

        <!-- Main App Activity -->
        <activity
            android:name="dev.patrickgold.florisboard.app.FlorisAppActivity"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/settings__title"
            android:launchMode="singleTask"
            android:roundIcon="@mipmap/ic_launcher"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/FlorisAppTheme.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ui" android:host="florisboard" android:pathPrefix="/" />
            </intent-filter>
            <intent-filter android:label="Import Extension">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
                <data android:mimeType="application/vnd.florisboard.extension+zip"/>
                <data android:mimeType="application/octet-stream"/><!-- Firefox looking at you :eyes: -->
            </intent-filter>
            <intent-filter android:label="Import Extension">
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.florisboard.extension+zip"/>
                <data android:mimeType="application/octet-stream"/><!-- Firefox looking at you :eyes: -->
            </intent-filter>
        </activity>

        <!-- Using an activity alias to disable/enable the app icon in the launcher -->
        <activity-alias
            android:name="dev.patrickgold.florisboard.SettingsLauncherAlias"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity="dev.patrickgold.florisboard.app.FlorisAppActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Crash Dialog Activity -->
        <activity
            android:name="dev.patrickgold.florisboard.lib.crashutility.CrashDialogActivity"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/crash_dialog__title"
            android:configChanges="orientation|screenSize"
            android:theme="@style/CrashDialogTheme"/>

        <!-- Voice Input Setup Activity -->
        <activity
            android:name="dev.patrickgold.florisboard.ime.voice.VoiceInputSetupActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/FlorisAppTheme.Transparent"/>

        <!-- Calendar Permission Activity -->
        <activity
            android:name="dev.patrickgold.florisboard.ime.calendar.CalendarPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/FlorisAppTheme.Transparent"/>

        <!-- Share-sheet target for image-to-clipboard. Exported without a custom
             permission so any app can share images via ACTION_SEND; input is
             validated at runtime by CopyToClipboardUriPolicy (scheme + MIME). -->
        <activity
            android:name="dev.patrickgold.florisboard.ime.clipboard.FlorisCopyToClipboardActivity"
            android:theme="@style/FlorisAppTheme.Transparent"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
        </activity>

        <!-- Share-sheet target for copying one local image into the app-private
             sticker pack. The provider later serves only the copied file, not
             the sender's transient content URI. -->
        <activity
            android:name="dev.patrickgold.florisboard.ime.media.sticker.StickerShareImportActivity"
            android:label="@string/sticker__share_import__label"
            android:theme="@style/FlorisAppTheme.Transparent"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
        </activity>

        <!-- Locale/Tasker setting plug-in configuration. The visible activity
             returns a compact HMAC-authenticated bundle only after the user
             explicitly saves it; the app-private signing key never leaves
             SwiftFloris. -->
        <activity
            android:name="dev.patrickgold.florisboard.ime.tasker.TaskerConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/tasker_plugin__title"
            android:theme="@style/FlorisAppTheme">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!-- Single Locale/Tasker setting receiver. Tasker invokes this
             explicitly with the configuration produced above. Runtime
             dispatch remains gated by privacy__external_automation_enabled
             and rejects malformed or unauthenticated bundles. -->
        <receiver
            android:name="dev.patrickgold.florisboard.ime.tasker.TaskerActionReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING"/>
            </intent-filter>
        </receiver>

        <!-- Clipboard Media File Provider -->
        <provider
            android:name="dev.patrickgold.florisboard.ime.clipboard.provider.ClipboardMediaProvider"
            android:authorities="${applicationId}.provider.clipboard"
            android:grantUriPermissions="true"
            android:exported="false">
        </provider>

        <!-- Bundled sticker file provider -->
        <provider
            android:name="dev.patrickgold.florisboard.ime.media.sticker.StickerMediaProvider"
            android:authorities="${applicationId}.provider.sticker"
            android:grantUriPermissions="true"
            android:exported="false">
        </provider>

        <!-- Default file provider to share files from the "files" or "cache" dir -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider.file"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <!-- Disable default EmojiCompat initializer -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove"/>
        </provider>

    </application>

</manifest>
